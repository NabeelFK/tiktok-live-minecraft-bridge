# TikTok LIVE -> Minecraft bridge: every variable the bridge reads.
#
# Copy this file to .env and fill it in, or set these in your shell. There are no
# defaults and no values baked into the source: if one is missing, the bridge prints
# the name of the variable and exits.
#
# .env is gitignored. Never commit it, and never paste RCON_PASSWORD or
# EULER_API_KEY into an issue, a screenshot, or a stream overlay.
#
# The bridge does NOT load .env by itself. Either set the variables in your shell:
#
#   PowerShell, this terminal only:   $env:MC_PLAYER = "YourName"
#   PowerShell, saved for new ones:   setx MC_PLAYER "YourName"     (reopen the terminal)
#   bash / zsh, this terminal only:   export MC_PLAYER=YourName
#
# or have Node read this file for you (Node 20.6+):
#
#   npx tsx --env-file=.env bridge.ts --keys
#
# docs/SETUP.md walks through all of it.


# Your exact in-game Minecraft name, case sensitive. Every command the map builds
# targets this player, so a typo here means commands that silently do nothing.
# Required by: --test, --verify, --replay and live mode. Not needed by --keys or --spy.
MC_PLAYER=

# Your TikTok handle, without the @, as it appears in your profile URL.
# Required by live mode only. `--user <name>` overrides it, and --spy takes the
# handle to watch as its own argument.
TIKTOK_USER=

# The RCON password you set in the server's server.properties (rcon.password).
# Required whenever the bridge actually talks to Minecraft: --test, --verify,
# --replay and live mode. Not needed with --dry, and not needed by --keys.
# This is a real credential for a server on your machine. Treat it like one.
RCON_PASSWORD=

# Euler Stream API key, for signing the TikTok LIVE websocket handshake.
# OPTIONAL. Leave it blank and signing still works at free community rate limits;
# a key raises those limits. Only live mode and --spy touch TikTok at all.
# Get one at https://www.eulerstream.com - see docs/SETUP.md for which tier.
EULER_API_KEY=
