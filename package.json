{
  "name": "tiktok-live-minecraft-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "Turns TikTok LIVE gifts into Minecraft commands over RCON.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "tsx bridge.test.ts",
    "typecheck": "tsc --noEmit",
    "keys": "tsx bridge.ts --keys",
    "verify": "tsx bridge.ts --verify",
    "sandbox": "tsx bridge.ts --test",
    "sandbox-singleplayer": "tsx bridge.ts --test --singleplayer",
    "spy": "tsx bridge.ts --spy",
    "spy-free": "tsx bridge.ts --provider piratetok --spy",
    "replay": "tsx bridge.ts --replay",
    "live": "tsx bridge.ts",
    "live-free": "tsx bridge.ts --provider piratetok",
    "live-singleplayer": "tsx bridge.ts --singleplayer",
    "live-singleplayer-free": "tsx bridge.ts --singleplayer --provider piratetok"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "piratetok-live-js": "0.1.5",
    "rcon-client": "4.2.5",
    "tiktok-live-connector": "2.4.4"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
